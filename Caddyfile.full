{
	email {$CADDY_EMAIL}
}

# Full stack only (docker-compose.full.yml) — proxies UI to Nuxt web:3000

{$CADDY_DOMAIN} {
	encode gzip

	handle /api* {
		reverse_proxy api:8000
	}

	handle /docs* {
		reverse_proxy api:8000
	}

	handle /openapi.json {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}

{$CADDY_API_DOMAIN} {
	encode gzip

	handle /api* {
		reverse_proxy api:8000
	}

	handle /docs* {
		reverse_proxy api:8000
	}

	handle /openapi.json {
		reverse_proxy api:8000
	}

	handle {
		redir /docs permanent
	}
}
