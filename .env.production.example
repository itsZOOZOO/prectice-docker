# Copy to .env.production and fill in. Never commit real secrets.

POSTGRES_DB=prectice
POSTGRES_USER=prectice
POSTGRES_PASSWORD=change-me-strong-db-password

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRE_HOURS=72

CADDY_DOMAIN=desk.example.com
CADDY_EMAIL=you@example.com
CORS_ORIGINS=https://desk.example.com

# Legacy S3 (same bucket as old PHP — keys only in DB)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=quantum-dental-patients-files
S3_REGION=ap-south-1
S3_URL_TTL=3600

# Optional — only needed on the machine that runs import_mysql.py
# MYSQL_HOST=db.pratikp.com
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=prctc_mngmt_pt
