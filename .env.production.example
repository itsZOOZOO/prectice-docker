# Copy to .env.production and fill in. Never commit real secrets.

POSTGRES_DB=prectice
POSTGRES_USER=prectice
POSTGRES_PASSWORD=change-me-strong-db-password

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRE_HOURS=72

# Public hosts (nginx TLS → Caddy on CADDY_HTTP_PORT)
CADDY_DOMAIN=dental.navapp.in
CADDY_API_DOMAIN=api.dental.navapp.in
CADDY_EMAIL=you@example.com
# docker-compose.api.yml publishes Caddy HTTP here (nginx upstream)
CADDY_HTTP_PORT=8080

# Comma-separated. Include Vercel URL after first deploy, e.g.:
#   https://dental.navapp.in,https://prectice-web.vercel.app
CORS_ORIGINS=https://dental.navapp.in
# Optional: allow all *.vercel.app previews (recommended for trial)
CORS_ORIGIN_REGEX=https://.*\.vercel\.app$

# Legacy S3 (same bucket as old PHP — keys only in DB)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=quantum-dental-patients-files
S3_REGION=ap-south-1
S3_URL_TTL=3600

# Optional — only needed on the machine that runs import_mysql.py
# MYSQL_HOST=db.pratikp.com
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=prctc_mngmt_pt
