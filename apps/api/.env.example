DATABASE_URL=postgresql+psycopg://drpratik@127.0.0.1:5432/prectice
JWT_SECRET=change-me-to-a-long-random-string
# Session length without / with Remember me
JWT_EXPIRE_HOURS=12
JWT_REMEMBER_EXPIRE_HOURS=720
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
APP_NAME=Prectice

# Google SSO via auth.pratikp.com (secret never goes to the browser)
SSO_AUTH_BASE_URL=https://auth.pratikp.com
SSO_APP_SLUG=navapp-dental
SSO_APP_SECRET=

# Public plan share (copy/share URL host for patients)
PLAN_PUBLIC_BASE_URL=https://myplan.in
# WhatsApp Meta template for plans (button domain is Meta-approved separately)
WA_PLAN_TEMPLATE_NAME=patient_plan_share_v_1
WA_PLAN_TEMPLATE_LANGUAGE=gu

# Legacy S3 (keys in DB; files stay in bucket — no file copy)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=quantum-dental-patients-files
S3_REGION=ap-south-1
S3_URL_TTL=3600

# Staff app notifications (reporting portal — not WhatsApp). Empty key disables.
REPORTING_API_URL=https://reporting.pratikp.com/api.php
